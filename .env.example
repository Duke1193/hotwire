# ---------------------------------------------------------------- multiplayer
# Optional. Without these the game runs single player and the room chip says
# OFFLINE. Create a project at supabase.com, then Project Settings > API keys.
# Realtime needs no tables and no auth: this app only uses Presence and
# Broadcast, and stores nothing.
#
# Use the PUBLISHABLE key (sb_publishable_...). It is safe in a browser bundle.
# NEVER put a secret / service_role key here: everything in a VITE_ variable is
# shipped to every player. The app refuses to start a client with one.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback, still accepted if the publishable key is not set. This is
# the old "anon public" JWT from the same settings page.
# VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------ analytics
# Optional. Without these no analytics client is loaded or shipped at all;
# events are still buffered on window.getawayEvents for local inspection.
# PostHog project settings > Project API key, and your instance host
# (https://eu.i.posthog.com or https://us.i.posthog.com).
# Players can decline analytics in the in-game privacy panel; Do Not Track is
# honoured automatically and session replay is never enabled.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
