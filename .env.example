# Multiplayer is optional. Without these the game runs in single player and
# says OFFLINE in the room chip.
#
# Create a project at supabase.com, then Project Settings > API.
# Realtime needs no tables and no auth: this app only uses Presence and
# Broadcast, and stores nothing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
